#!/usr/bin/env bash
# Blocks a commit message that contains a denylist term, a secret, a
# private IPv4 address, or an absolute home path.
set -u
hook_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/hooks/_scan.sh
. "$hook_dir/_scan.sh"

check_denylist_env || exit 1

# Scan every line. Lines starting with "#" are kept in the stored message
# when the commit uses -m, so they are scanned too. Only a verbose-commit
# diff below git's scissors line is left out.
if ! sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | scan_text "commit message"; then
  echo "hook: commit message rejected. Reword it." >&2
  exit 1
fi
exit 0

#!/usr/bin/env bash
# Blocks a commit whose added lines or file paths contain a denylist term,
# a secret, a private IPv4 address, or an absolute home path.
set -u
hook_dir="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/hooks/_scan.sh
. "$hook_dir/_scan.sh"

check_denylist_env || exit 1

status=0

# Staged file paths.
# quotepath=off keeps non-ASCII names unescaped, so each one can be diffed.
paths="$(git -c core.quotepath=off diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$paths" | scan_text "staged file paths"; then
  status=1
fi

# Added lines, per file, so a hit names the file.
while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Added lines are taken only after the first hunk header, so an added
  # line that itself starts with "++" is not mistaken for the file header.
  if ! git -c core.quotepath=off diff --cached -U0 --no-color -- "$f" \
      | awk '/^@@/ {h = 1; next} h && /^\+/ {print substr($0, 2)}' \
      | scan_text "$f"; then
    status=1
  fi
done <<< "$paths"

if [ "$status" -ne 0 ]; then
  echo "hook: commit rejected. Fix the content, never the hook." >&2
fi
exit "$status"
